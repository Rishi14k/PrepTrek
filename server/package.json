{
  "name": "preptrack-server",
  "version": "1.0.0",
  "description": "Backend API for PrepTrack Entrance Exam Analytics Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seedSubjects.js && node scripts/seedAdmin.js",
